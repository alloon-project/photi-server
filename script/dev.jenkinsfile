pipeline {
   agent any
   environment {
       SCRIPT_PATH = '/var/jenkins_home/custom/photi'
   }
   tools {
       gradle 'gradle'
   }
   stages {
       stage('Github') {
           steps {
               git branch: 'chore/#188-cd', credentialsId: "$GIT_CREDENTIALS_ID", url: 'https://github.com/alloon-project/photi-server.git'
           }
       }
       stage('Build') {
           steps {
               sh "./gradlew clean bootJar"
           }
       }
       stage('Deploy') {
           steps {
               sshagent(credentials: ["$EC2_CREDENTIALS_ID"]) {
                  sh '''
                     scp -o StrictHostKeyChecking=no build/libs/*.jar ubuntu@$EC2_DEV_PRIVATE_IP:$SCRIPT_PATH
                     ssh -o StrictHostKeyChecking=no ubuntu@$EC2_DEV_PRIVATE_IP "bash $SCRIPT_PATH/deploy.sh"
                  '''
               }
           }
       }
   }
}
